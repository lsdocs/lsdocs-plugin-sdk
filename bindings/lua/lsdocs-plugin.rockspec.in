-- The rockspec template: lsdocs/.github's build-rocks.yml writes
-- lsdocs-plugin-<version>-1.rockspec from it, @VERSION@ being the version of the
-- lsdocs-plugin-lua crate and @SHA256@ the SHA-256 of each prebuilt module it
-- built (one `["<lua>-<target>"] = "<hash>",` line per archive).
--
-- luarocks-build-lsdocs-prebuilt (lsdocs/.github) installs the prebuilt
-- module attached to the release for this Lua and platform, and builds
-- from source with cargo (luarocks-build-rust-mlua) when there is none.
rockspec_format = "3.0"
package = "lsdocs-plugin"
version = "@VERSION@-1"

source = {
  url = "git+https://github.com/lsdocs/lsdocs-plugin-sdk",
  tag = "lsdocs-plugin-lua/v@VERSION@",
}

description = {
  summary = "Write lsdocs plugins in Lua.",
  detailed = [[
The lsdocs plugin SDK for Lua: a plugin is Lua functions handling parse,
transform and render requests; the protocol runs in Rust.
]],
  homepage = "https://github.com/lsdocs/lsdocs-plugin-sdk",
  license = "Apache-2.0 OR MIT",
}

-- Lua 5.4 and LuaJIT (5.1 API).
dependencies = {
  "lua >= 5.1",
}

build_dependencies = {
  "luarocks-build-lsdocs-prebuilt",
}

build = {
  type = "lsdocs-prebuilt",
  url = "https://github.com/lsdocs/lsdocs-plugin-sdk/releases/download/lsdocs-plugin-lua%2Fv@VERSION@",
  sha256 = {
@SHA256@
  },
  modules = {
    -- require("lsdocs_plugin") <- the lsdocs_plugin_lua library.
    ["lsdocs_plugin"] = "lsdocs_plugin_lua",
  },
  default_features = false,
  features = { "module" },
}
