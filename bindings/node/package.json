{
  "name": "@lsdocs/plugin",
  "version": "0.1.0",
  "description": "Write lsdocs plugins in JavaScript or TypeScript.",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsdocs/lsdocs-plugin-sdk.git",
    "directory": "bindings/node"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "default": "./testing.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "testing.js",
    "testing.d.ts",
    "native.js",
    "native.d.ts"
  ],
  "engines": {
    "node": ">=20"
  },
  "napi": {
    "binaryName": "lsdocs",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "scripts": {
    "build": "napi build --platform --js native.js --dts native.d.ts",
    "test": "node --test test/",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@msgpack/msgpack": "^3.1.3",
    "@napi-rs/cli": "^3.10.12",
    "@types/node": "^26.6.6",
    "publint": "^0.3.25",
    "typescript": "^7.0.0"
  },
  "type": "commonjs"
}
